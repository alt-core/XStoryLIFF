{
  "name": "xstoryliff",
  "version": "0.1.0",
  "private": true,
  "description": "XStoryBotと組み合わせて使う、LINEのLIFF向けインタラクティブストーリー画面エンジン",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@line/liff": "^2.31.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.2",
    "happy-dom": "^20.14.5",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
