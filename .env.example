# .env.local（本番用だけなら .env.production.local）へコピーして値を書く。
# VITE_ で始まる値は画面に埋め込まれて公開されるので、秘密の値は書かない。
#
# 使う作品（projects/<名前>/）は、.env に XSTORYLIFF_PROJECT=<名前> と書いて選ぶ（書かなければ同梱のデモ）。
# .env はコミットして共有する。ここ（.env.local）に空の XSTORYLIFF_PROJECT を書くと、.env の選択を打ち消すので書かない。

# ---- LINE で開く時 ----
# LINE Developers で作った LIFF アプリの ID
VITE_LIFF_ID=

# XStoryBot の API の基点（https://<Botのホスト>）と Bot名。LIFF API は <基点>/liff/<Bot名>/message
VITE_API_BASE_URL=
VITE_BOT=

# 任意。LINE アプリの外で開かれた時の転送先（友だち追加のページなど）。空なら LINE ログインして表示する
VITE_FORWARD_URL=

# ---- XStoryBot の Webchat で開く時 ----
# ページを iframe で開く Webchat の画面のオリジン（https://<Webchatのホスト>。pathは含めない）
VITE_WEBCHAT_ORIGIN=
